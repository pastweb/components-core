{
  "name": "xjs-highlighteer",
  "version": "0.0.0",
  "packageManager": "npm@10.9.2",
  "description": "A starter for creating a tsdown package.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/gugustinette/create-tsdown#readme",
  "bugs": {
    "url": "https://github.com/gugustinette/create-tsdown/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gugustinette/create-tsdown.git"
  },
  "author": "Domenico Pasto <domenico.pasto@gmail.com>",
  "funding": "https://github.com/sponsors/sxzz",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp && npm publish",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/prismjs": "^1.26.5",
    "bumpp": "^10.1.0",
    "eslint": "^9.26.0",
    "happy-dom": "^17.4.7",
    "prettier": "^3.5.3",
    "tsdown": "^0.11.9",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "prettier": "@sxzz/prettier-config",
  "dependencies": {
    "prismjs": "^1.30.0"
  }
}
